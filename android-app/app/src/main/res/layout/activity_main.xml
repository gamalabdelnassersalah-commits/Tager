<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/white">

    <TextView
        android:id="@+id/statusBanner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="10dp"
        android:layout_marginTop="6dp"
        android:gravity="center"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:background="@drawable/status_banner_bg"
        android:text="جاري الاتصال..."
        android:textColor="@color/tager_teal_dark"
        android:textSize="12sp"
        android:textStyle="bold"
        android:clickable="true"
        android:focusable="true"
        android:accessibilityLiveRegion="polite"
        android:importantForAccessibility="yes"
        android:contentDescription="حالة الاتصال. اضغط لإعادة المحاولة"
        android:visibility="gone" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <com.tager.marketplace.TagerSwipeRefreshLayout
            android:id="@+id/swipeRefresh"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <WebView
                android:id="@+id/webView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/white"
                android:importantForAccessibility="yes" />
        </com.tager.marketplace.TagerSwipeRefreshLayout>

        <ProgressBar
            android:id="@+id/progressBar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:layout_gravity="top"
            android:max="100"
            android:progressTint="@color/tager_orange"
            android:importantForAccessibility="no"
            android:visibility="gone" />

        <FrameLayout
            android:id="@+id/nativeLoading"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/white"
            android:importantForAccessibility="noHideDescendants">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:src="@drawable/tager_splash"
                android:contentDescription="@null" />

            <ProgressBar
                style="?android:attr/progressBarStyle"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="center_horizontal|bottom"
                android:layout_marginBottom="42dp"
                android:indeterminateTint="@color/tager_orange"
                android:importantForAccessibility="no" />
        </FrameLayout>

        <LinearLayout
            android:id="@+id/offlinePanel"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="34dp"
            android:background="@color/white"
            android:importantForAccessibility="yes"
            android:visibility="gone">

            <ImageView
                android:layout_width="160dp"
                android:layout_height="160dp"
                android:adjustViewBounds="true"
                android:scaleType="fitCenter"
                android:src="@drawable/tager_launcher"
                android:contentDescription="@null" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="تعذر الاتصال"
                android:textColor="@color/tager_teal_dark"
                android:textStyle="bold"
                android:textSize="24sp"
                android:accessibilityHeading="true" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="9dp"
                android:gravity="center"
                android:text="تأكد من اتصال الإنترنت ثم أعد المحاولة"
                android:textColor="@color/tager_text_muted"
                android:textSize="15sp" />

            <Button
                android:id="@+id/retryButton"
                android:layout_width="210dp"
                android:layout_height="wrap_content"
                android:minHeight="50dp"
                android:layout_marginTop="24dp"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:text="إعادة المحاولة"
                android:textAllCaps="false"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:contentDescription="إعادة محاولة الاتصال"
                android:backgroundTint="@color/tager_teal" />
        </LinearLayout>
    </FrameLayout>

    <LinearLayout
        android:id="@+id/nativeBottomNav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="72dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
        android:paddingTop="5dp"
        android:paddingBottom="5dp"
        android:background="@color/white"
        android:elevation="12dp"
        android:importantForAccessibility="yes">

        <TextView
            android:id="@+id/navHome"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:minHeight="62dp"
            android:layout_weight="1"
            android:gravity="center"
            android:background="@drawable/nav_item_bg"
            android:drawableTop="@drawable/ic_nav_home"
            android:drawablePadding="2dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:text="الرئيسية"
            android:textColor="@color/nav_item_color"
            android:textSize="11sp"
            android:textStyle="bold"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="الرئيسية" />

        <TextView
            android:id="@+id/navProducts"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:minHeight="62dp"
            android:layout_weight="1"
            android:gravity="center"
            android:background="@drawable/nav_item_bg"
            android:drawableTop="@drawable/ic_nav_products"
            android:drawablePadding="2dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:text="المنتجات"
            android:textColor="@color/nav_item_color"
            android:textSize="11sp"
            android:textStyle="bold"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="المنتجات" />

        <TextView
            android:id="@+id/navSuppliers"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:minHeight="62dp"
            android:layout_weight="1"
            android:gravity="center"
            android:background="@drawable/nav_item_bg"
            android:drawableTop="@drawable/ic_nav_suppliers"
            android:drawablePadding="2dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:text="الموردون"
            android:textColor="@color/nav_item_color"
            android:textSize="11sp"
            android:textStyle="bold"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="الموردون" />

        <TextView
            android:id="@+id/navTrack"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:minHeight="62dp"
            android:layout_weight="1"
            android:gravity="center"
            android:background="@drawable/nav_item_bg"
            android:drawableTop="@drawable/ic_nav_track"
            android:drawablePadding="2dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:text="التتبع"
            android:textColor="@color/nav_item_color"
            android:textSize="11sp"
            android:textStyle="bold"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="تتبع الطلب" />

        <TextView
            android:id="@+id/navCart"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:minHeight="62dp"
            android:layout_weight="1"
            android:gravity="center"
            android:background="@drawable/nav_item_bg"
            android:drawableTop="@drawable/ic_nav_cart"
            android:drawablePadding="2dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:text="السلة"
            android:textColor="@color/nav_item_color"
            android:textSize="11sp"
            android:textStyle="bold"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="سلة المشتريات" />
    </LinearLayout>
</LinearLayout>
