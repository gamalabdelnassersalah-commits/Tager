<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Tager" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">@color/tager_teal_dark</item>
        <item name="android:navigationBarColor">@color/tager_teal_dark</item>
        <item name="android:colorAccent">@color/tager_orange</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowNoTitle">true</item>
    </style>

    <style name="Theme.Tager.Starting" parent="@style/Theme.Tager">
        <item name="android:windowBackground">@drawable/tager_starting_background</item>
        <item name="android:windowDisablePreview">false</item>
    </style>
</resources>
